<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FlavorVault.ViewModels"
             xmlns:converters="clr-namespace:FlavorVault.Converters"
             x:Class="FlavorVault.Views.EntryEditPage"
             x:DataType="viewmodels:EntryEditViewModel"
             Title="Edit Entry"
             BackgroundColor="{DynamicResource Background}">

    <ContentPage.Resources>
        <converters:StringToUriConverter x:Key="StringToUriConverter" />
        <converters:StringNotNullConverter x:Key="StringNotNullConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:BoolToColorConverter x:Key="StarColorConverter"
                                         TrueColor="#FFB300"
                                         FalseColor="#E0E0E0" />
        <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <!-- Scrollable form -->
        <ScrollView Padding="16,8">
            <VerticalStackLayout Spacing="20">

                <!-- Image section -->
                <VerticalStackLayout Spacing="12">
                    <Border HeightRequest="150"
                            BackgroundColor="{DynamicResource PrimaryLight}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="1"
                            Stroke="{DynamicResource PrimaryLight}"
                            HorizontalOptions="Fill">
                        <Grid>
                            <!-- Placeholder -->
                            <VerticalStackLayout HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Spacing="8"
                                                 IsVisible="{Binding HasImage, Converter={StaticResource InverseBoolConverter}}">
                                <Label FontFamily="fa-solid-900"
                                       Text="&#xf0f5;"
                                       FontSize="{DynamicResource FontSize36}"
                                       TextColor="{DynamicResource TextSecondary}"
                                       HorizontalOptions="Center" />
                                <Label Text="Tap the button below to add an image"
                                       FontSize="{DynamicResource FontSize13}"
                                       TextColor="{DynamicResource TextSecondary}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <!-- Image preview -->
                            <Image Source="{Binding ImagePath, Converter={StaticResource StringToUriConverter}}"
                                   Aspect="AspectFill"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />
                        </Grid>
                    </Border>

                    <!-- Image action buttons -->
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="16">
                        <Border WidthRequest="48"
                                HeightRequest="48"
                                StrokeShape="RoundRectangle 24"
                                BackgroundColor="{DynamicResource PrimaryLight}"
                                StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TakePhotoCommand}" />
                            </Border.GestureRecognizers>
                            <Label FontFamily="fa-solid-900"
                                   Text="&#xf030;"
                                   FontSize="{DynamicResource FontSize18}"
                                   TextColor="{DynamicResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   AutomationId="BtnTakePhoto"
                                   SemanticProperties.Description="Take photo"
                                   SemanticProperties.Hint="Tap to take photo" />
                        </Border>

                        <Border WidthRequest="48"
                                HeightRequest="48"
                                StrokeShape="RoundRectangle 24"
                                BackgroundColor="{DynamicResource PrimaryLight}"
                                StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickPhotoCommand}" />
                            </Border.GestureRecognizers>
                            <Label FontFamily="fa-solid-900"
                                   Text="&#xf03e;"
                                   FontSize="{DynamicResource FontSize18}"
                                   TextColor="{DynamicResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   AutomationId="BtnPickPhoto"
                                   SemanticProperties.Description="Pick from gallery"
                                   SemanticProperties.Hint="Tap to pick from gallery" />
                        </Border>

                        <Border WidthRequest="48"
                                HeightRequest="48"
                                StrokeShape="RoundRectangle 24"
                                BackgroundColor="{DynamicResource PrimaryLight}"
                                StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleFlashCommand}" />
                            </Border.GestureRecognizers>
                            <Label FontFamily="fa-solid-900"
                                   Text="&#xf0e7;"
                                   FontSize="{DynamicResource FontSize18}"
                                   TextColor="{Binding IsFlashOn, Converter={StaticResource StarColorConverter}}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   AutomationId="BtnFlash"
                                   SemanticProperties.Description="Flash"
                                   SemanticProperties.Hint="Tap to toggle flash" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Food name -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Food Name"
                           FontSize="{DynamicResource FontSize14}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           SemanticProperties.Description="Food name" />
                    <Entry Text="{Binding Name}"
                           Placeholder="Enter food name"
                           FontSize="{DynamicResource FontSize16}"
                           HeightRequest="56"
                           BackgroundColor="{DynamicResource Surface}"
                           AutomationId="EntryName"
                           SemanticProperties.Description="Food name input"
                           SemanticProperties.Hint="Enter the food name" />
                </VerticalStackLayout>

                <!-- Cuisine region -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Cuisine Region"
                           FontSize="{DynamicResource FontSize14}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Picker ItemsSource="{Binding Regions}"
                            SelectedIndex="{Binding SelectedRegionIndex}"
                            Title="Select cuisine region"
                            FontSize="{DynamicResource FontSize16}"
                            HeightRequest="56"
                            BackgroundColor="{DynamicResource Surface}"
                            AutomationId="PickerRegion"
                            SemanticProperties.Description="Cuisine region selector"
                            SemanticProperties.Hint="Select cuisine region" />
                </VerticalStackLayout>

                <!-- Rarity -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Rarity"
                           FontSize="{DynamicResource FontSize14}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Picker ItemsSource="{Binding Rarities}"
                            SelectedIndex="{Binding SelectedRarityIndex}"
                            Title="Select rarity"
                            FontSize="{DynamicResource FontSize16}"
                            HeightRequest="56"
                            BackgroundColor="{DynamicResource Surface}"
                            AutomationId="PickerRarity"
                            SemanticProperties.Description="Rarity selector"
                            SemanticProperties.Hint="Select rarity" />
                </VerticalStackLayout>

                <!-- Price range -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Price Range"
                           FontSize="{DynamicResource FontSize14}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Picker ItemsSource="{Binding PriceRanges}"
                            SelectedIndex="{Binding SelectedPriceIndex}"
                            Title="Select price range"
                            FontSize="{DynamicResource FontSize16}"
                            HeightRequest="56"
                            BackgroundColor="{DynamicResource Surface}"
                            AutomationId="PickerPrice"
                            SemanticProperties.Description="Price range selector"
                            SemanticProperties.Hint="Select price range" />
                </VerticalStackLayout>

                <!-- Star rating -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Star Rating"
                           FontSize="{DynamicResource FontSize14}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           SemanticProperties.Description="Star rating" />
                    <HorizontalStackLayout Spacing="12"
                                           HorizontalOptions="Center">
                        <Label FontFamily="fa-solid-900"
                               Text="&#xf005;"
                               FontSize="{DynamicResource FontSize32}"
                               TextColor="{Binding IsStar1, Converter={StaticResource StarColorConverter}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetRatingCommand}"
                                                      CommandParameter="1" />
                            </Label.GestureRecognizers>
                            <Label.AutomationId>Star1</Label.AutomationId>
                        </Label>
                        <Label FontFamily="fa-solid-900"
                               Text="&#xf005;"
                               FontSize="{DynamicResource FontSize32}"
                               TextColor="{Binding IsStar2, Converter={StaticResource StarColorConverter}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetRatingCommand}"
                                                      CommandParameter="2" />
                            </Label.GestureRecognizers>
                            <Label.AutomationId>Star2</Label.AutomationId>
                        </Label>
                        <Label FontFamily="fa-solid-900"
                               Text="&#xf005;"
                               FontSize="{DynamicResource FontSize32}"
                               TextColor="{Binding IsStar3, Converter={StaticResource StarColorConverter}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetRatingCommand}"
                                                      CommandParameter="3" />
                            </Label.GestureRecognizers>
                            <Label.AutomationId>Star3</Label.AutomationId>
                        </Label>
                        <Label FontFamily="fa-solid-900"
                               Text="&#xf005;"
                               FontSize="{DynamicResource FontSize32}"
                               TextColor="{Binding IsStar4, Converter={StaticResource StarColorConverter}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetRatingCommand}"
                                                      CommandParameter="4" />
                            </Label.GestureRecognizers>
                            <Label.AutomationId>Star4</Label.AutomationId>
                        </Label>
                        <Label FontFamily="fa-solid-900"
                               Text="&#xf005;"
                               FontSize="{DynamicResource FontSize32}"
                               TextColor="{Binding IsStar5, Converter={StaticResource StarColorConverter}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetRatingCommand}"
                                                      CommandParameter="5" />
                            </Label.GestureRecognizers>
                            <Label.AutomationId>Star5</Label.AutomationId>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Flavor profile -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Flavor Profile"
                           FontSize="{DynamicResource FontSize14}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           SemanticProperties.Description="Flavor profile" />

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Primary Taste"
                               FontSize="{DynamicResource FontSize13}"
                               TextColor="{DynamicResource TextSecondary}" />
                        <Picker ItemsSource="{Binding Tastes}"
                                SelectedIndex="{Binding SelectedTasteIndex}"
                                Title="Select primary taste"
                                FontSize="{DynamicResource FontSize14}"
                                HeightRequest="56"
                                BackgroundColor="{DynamicResource Surface}"
                                AutomationId="PickerTaste"
                                SemanticProperties.Description="Primary taste selector"
                                SemanticProperties.Hint="Select primary taste" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Aroma"
                               FontSize="{DynamicResource FontSize13}"
                               TextColor="{DynamicResource TextSecondary}" />
                        <Picker ItemsSource="{Binding Aromas}"
                                SelectedIndex="{Binding SelectedAromaIndex}"
                                Title="Select aroma"
                                FontSize="{DynamicResource FontSize14}"
                                HeightRequest="56"
                                BackgroundColor="{DynamicResource Surface}"
                                AutomationId="PickerAroma"
                                SemanticProperties.Description="Aroma selector"
                                SemanticProperties.Hint="Select aroma tag" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Texture"
                               FontSize="{DynamicResource FontSize13}"
                               TextColor="{DynamicResource TextSecondary}" />
                        <Picker ItemsSource="{Binding Textures}"
                                SelectedIndex="{Binding SelectedTextureIndex}"
                                Title="Select texture"
                                FontSize="{DynamicResource FontSize14}"
                                HeightRequest="56"
                                BackgroundColor="{DynamicResource Surface}"
                                AutomationId="PickerTexture"
                                SemanticProperties.Description="Texture selector"
                                SemanticProperties.Hint="Select texture tag" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Ingredients -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Main Ingredients"
                           FontSize="{DynamicResource FontSize14}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           SemanticProperties.Description="Main ingredients" />
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Text="{Binding IngredientsText}"
                               Placeholder="Comma-separated, e.g.: tofu, beef, Sichuan pepper"
                               FontSize="{DynamicResource FontSize14}"
                               HeightRequest="56"
                               BackgroundColor="{DynamicResource Surface}"
                               AutomationId="EntryIngredients"
                               SemanticProperties.Description="Ingredients input"
                               SemanticProperties.Hint="Enter main ingredients, comma-separated" />
                        <Border Grid.Column="1"
                                WidthRequest="44"
                                HeightRequest="56"
                                StrokeShape="RoundRectangle 22"
                                BackgroundColor="{DynamicResource PrimaryLight}"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding VoiceIngredientsCommand}" />
                            </Border.GestureRecognizers>
                            <Label FontFamily="fa-solid-900"
                                   Text="&#xf130;"
                                   FontSize="{DynamicResource FontSize16}"
                                   TextColor="{DynamicResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   AutomationId="BtnVoiceIngredients"
                                   SemanticProperties.Description="Voice input ingredients"
                                   SemanticProperties.Hint="Tap to voice input ingredients" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Collection notes -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Notes"
                           FontSize="{DynamicResource FontSize14}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           SemanticProperties.Description="Collection notes" />
                    <Grid RowDefinitions="Auto,Auto">
                        <Editor Grid.Row="0"
                                Text="{Binding NoteText}"
                                Placeholder="Write your tasting notes..."
                                FontSize="{DynamicResource FontSize14}"
                                HeightRequest="100"
                                BackgroundColor="{DynamicResource Surface}"
                                AutomationId="EditorNote"
                                SemanticProperties.Description="Collection notes input"
                                SemanticProperties.Hint="Enter collection notes" />

                        <HorizontalStackLayout Grid.Row="1"
                                               HorizontalOptions="End"
                                               Spacing="8"
                                               Margin="0,8,0,0">
                            <!-- Voice input button -->
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{DynamicResource PrimaryLight}"
                                    StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding VoiceNoteCommand}" />
                                </Border.GestureRecognizers>
                                <Label FontFamily="fa-solid-900"
                                       Text="&#xf130;"
                                       FontSize="{DynamicResource FontSize14}"
                                       TextColor="{DynamicResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       AutomationId="BtnVoiceNote"
                                       SemanticProperties.Description="Voice input notes"
                                       SemanticProperties.Hint="Tap to voice input notes" />
                            </Border>

                            <!-- Listening indicator -->
                            <Label Text="Listening..."
                                   FontSize="{DynamicResource FontSize13}"
                                   TextColor="{DynamicResource Accent}"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsListening}"
                                   AutomationId="LblListening"
                                   SemanticProperties.Description="Listening to voice" />
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- Location section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Discovery Location"
                           FontSize="{DynamicResource FontSize14}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           SemanticProperties.Description="Discovery location" />

                    <!-- Get current location button -->
                    <Border BackgroundColor="{DynamicResource PrimaryLight}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            Padding="12,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GetLocationCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center"
                                                Spacing="8">
                            <Label FontFamily="fa-solid-900"
                                   Text="&#xf3c5;"
                                   FontSize="{DynamicResource FontSize14}"
                                   TextColor="{DynamicResource Primary}"
                                   VerticalOptions="Center"
                                   AutomationId="IconGetLocation"
                                   SemanticProperties.Description="Location icon" />
                            <Label Text="Get Current Location"
                                   FontSize="{DynamicResource FontSize14}"
                                   TextColor="{DynamicResource Primary}"
                                   VerticalOptions="Center"
                                   AutomationId="BtnGetLocation"
                                   SemanticProperties.Description="Get current location"
                                   SemanticProperties.Hint="Tap to get current location" />
                            <ActivityIndicator IsRunning="{Binding IsLocating}"
                                               IsVisible="{Binding IsLocating}"
                                               Color="{DynamicResource Primary}"
                                               WidthRequest="16"
                                               HeightRequest="16"
                                               VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Location name -->
                    <Entry Text="{Binding LocationName}"
                           Placeholder="Location name"
                           FontSize="{DynamicResource FontSize14}"
                           HeightRequest="56"
                           BackgroundColor="{DynamicResource Surface}"
                           AutomationId="EntryLocationName"
                           SemanticProperties.Description="Location name input"
                           SemanticProperties.Hint="Enter the discovery location name" />

                    <!-- Discovery date -->
                    <DatePicker Date="{Binding DiscoverDate, TargetNullValue='2026-01-01'}"
                                Format="yyyy-MM-dd"
                                FontSize="{DynamicResource FontSize14}"
                                HeightRequest="56"
                                BackgroundColor="{DynamicResource Surface}"
                                AutomationId="DatePickerDiscover"
                                SemanticProperties.Description="Discovery date"
                                SemanticProperties.Hint="Select the discovery date" />
                </VerticalStackLayout>

                <!-- Assign to collection -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Add to Collection"
                           FontSize="{DynamicResource FontSize14}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           SemanticProperties.Description="Add to collection" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Collections}"
                                         Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:CollectionCheckItem">
                                <HorizontalStackLayout Spacing="8"
                                                       VerticalOptions="Center">
                                    <CheckBox IsChecked="{Binding IsChecked}"
                                              Color="{DynamicResource Primary}"
                                              AutomationId="CheckBoxCollection"
                                              SemanticProperties.Description="{Binding CollectionName}"
                                              SemanticProperties.Hint="Select whether to add to this collection" />
                                    <Label Text="{Binding CollectionName}"
                                           FontSize="{DynamicResource FontSize14}"
                                           TextColor="{DynamicResource TextPrimary}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Bottom spacing -->
                <BoxView HeightRequest="80" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom action bar -->
        <Border Grid.Row="1"
                BackgroundColor="{DynamicResource Surface}"
                StrokeThickness="0"
                Padding="16,12"
                HorizontalOptions="Fill">
            <Border.Shadow>
                <Shadow Brush="#20000000"
                        Offset="0,-2"
                        Radius="8" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="16">
                <Button Grid.Column="0"
                        Text="Cancel"
                        FontSize="{DynamicResource FontSize16}"
                        TextColor="{DynamicResource TextSecondary}"
                        BackgroundColor="{DynamicResource PrimaryLight}"
                        Command="{Binding CancelCommand}"
                        CornerRadius="24"
                        HeightRequest="48"
                        AutomationId="BtnCancel"
                        SemanticProperties.Description="Cancel"
                        SemanticProperties.Hint="Tap to cancel editing" />

                <Button Grid.Column="1"
                        Text="Save"
                        FontSize="{DynamicResource FontSize16}"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="{DynamicResource Primary}"
                        Command="{Binding SaveCommand}"
                        CornerRadius="24"
                        HeightRequest="48"
                        AutomationId="BtnSave"
                        SemanticProperties.Description="Save"
                        SemanticProperties.Hint="Tap to save entry" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>
